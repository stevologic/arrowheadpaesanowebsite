{{- $pages := where .Site.RegularPages "Section" "narrative" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>The Chiefs Narrative | {{ .Site.Title }}</title>
    <link>{{ if .IsHome }}{{ "" | absURL }}{{ else }}{{ .Permalink }}{{ end }}</link>
    <description>{{ .Site.Params.description }}</description>
    <generator>Hugo</generator>
    {{ with .Site.LanguageCode }}<language>{{ . }}</language>{{ end }}
    {{ with .OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{ end }}
    {{ if or .IsHome (and (eq .Section "narrative") (eq .Kind "section")) }}
    <item>
      <title>{{ with .Site.Data.narrative }}{{ .headline | default "The Chiefs Narrative" }}{{ else }}The Chiefs Narrative{{ end }}</title>
      <link>{{ "" | absURL }}</link>
      <guid>{{ "" | absURL }}</guid>
      <description>{{ with .Site.Data.narrative }}{{ .dek }}{{ end }}</description>
      {{ with .Site.Data.narrative }}{{ with .generatedAt }}<pubDate>{{ (time.AsTime .) | time.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>{{ end }}{{ end }}
    </item>
    {{ end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid>{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ .Title }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
