{
  "name": "arrowhead-paesano",
  "version": "1.0.0",
  "private": true,
  "description": "The daily Chiefs Narrative from Arrowhead Paesano",
  "scripts": {
    "build": "hugo --gc --minify",
    "dev": "hugo server --bind 127.0.0.1 --port 1515 --baseURL http://localhost:1515/ --disableFastRender --renderToMemory",
    "dev:affiliates": "hugo server --bind 127.0.0.1 --port 1516 --baseURL http://localhost:1516/ --environment development --config hugo.yaml,config/affiliate-preview.yaml --disableFastRender --renderToMemory",
    "check:affiliates": "node scripts/check-affiliate-footer.mjs"
  },
  "devDependencies": {
    "hugo-bin": "^0.165.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "hugo-bin": {
    "buildTags": "extended",
    "version": "0.152.2"
  },
  "allowScripts": {
    "hugo-bin@0.165.0": true
  }
}
