{
  "name": "arrowhead-paesano",
  "version": "1.0.0",
  "private": true,
  "description": "The daily Chiefs Narrative from Arrowhead Paesano",
  "scripts": {
    "build": "npm run check:three && hugo --gc --minify",
    "dev": "hugo server --bind 127.0.0.1 --port 1515 --baseURL http://localhost:1515/ --disableFastRender --renderToMemory",
    "dev:affiliates": "hugo server --bind 127.0.0.1 --port 1516 --baseURL http://localhost:1516/ --environment development --config hugo.yaml,tools/affiliate-preview.yaml --buildDrafts --disableFastRender --renderToMemory",
    "check:affiliates": "node scripts/check-affiliate-footer.mjs",
    "vendor:three": "node scripts/build-three.mjs",
    "check:three": "node scripts/build-three.mjs --check"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "hugo-bin": "^0.167.0",
    "three": "0.186.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "hugo-bin": {
    "buildTags": "extended",
    "version": "0.152.2"
  },
  "allowScripts": {
    "hugo-bin@0.165.0": true
  }
}
